# Copy to .env and adjust. .env is git-ignored; this file is not.
STORE_MODE=real
DATA_DIR=data
FRONTEND_ORIGINS=http://localhost:5173
STORE_TIMEOUT_SECONDS=2

MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=app

CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=app
CASSANDRA_LOCAL_DC=dc1
# ONE locally (single node); QUORUM on the 3-node VM cluster
CASSANDRA_CONSISTENCY=ONE

REDIS_URL=redis://127.0.0.1:6379/0

# On the VMs, use Sentinel instead of REDIS_URL:
# REDIS_SENTINELS=433-10.csse.rose-hulman.edu:26379,433-11.csse.rose-hulman.edu:26379,433-12.csse.rose-hulman.edu:26379
# REDIS_MASTER_NAME=mymaster
# REDIS_PASSWORD=your-redis-password